@startuml
title Последовательность: выгрузка груза на станции назначения
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
autonumber

actor "Оператор станции" as Operator
participant "Веб-клиент" as Client
participant "HTTP API" as API
participant "Cargo use cases" as Cargo
participant "Routing" as Routing
database "База данных" as DB

Operator -> Client : Выбрать груз «в пути»
Client -> API : UnloadCargoCommand(cargo_id)
API -> Cargo : Выгрузить груз
Cargo -> Identity : Получить station_id оператора
Identity --> Cargo : station_id
Cargo -> DB : Проверить станцию назначения и поезд
DB --> Cargo : Cargo и Train
Cargo -> Infrastructure : Проверить статус поезда arrived
alt поезд прибыл на станцию назначения
  Infrastructure --> Cargo : Прибыл
  Cargo -> DB : Сохранить статус available_for_pickup
  Cargo --> API : CargoDto
  API --> Client : Груз доступен получателю
else поезд не прибыл или станция чужая
  Infrastructure --> Cargo : Проверка не пройдена
  Cargo --> API : ValidationError
  API --> Client : Показать ошибку
end
Client --> Operator : Результат операции
@enduml
