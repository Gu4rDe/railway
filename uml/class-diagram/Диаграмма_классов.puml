@startuml
title Class Diagram of the "Railway" System

left to right direction
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 70
skinparam ranksep 90
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam ClassBorderColor #2F5D8A
skinparam ClassBackgroundColor #FFFFFF
skinparam PackageBorderColor #455468
skinparam PackageBackgroundColor #F7F9FC

package "System Users" {
  abstract class User {
    - identifier: String
    - password: String
    - name: String
    + login(identifier, password): boolean
    + logout(): void
  }

  class Administrator {
    + addStation(station): void
    + removeStation(station): void
    + addOperator(operator): void
    + removeOperator(operator): void
    + addTrain(train): void
    + removeTrain(train): void
  }

  class Operator {
    + receiveCargo(cargo): void
    + assignCargo(cargo, train): void
    + collectCargo(cargoId): void
  }
}

package "Railway System" {
  class Station {
    - code: String
    - name: String
    + addOperator(operator): void
    + removeOperator(operator): void
  }

  class Train {
    - number: String
    - status: TrainStatus
    + goesTo(station): boolean
    + addStation(station): void
  }

  class Route {
    - stations: List<Station>
    + contains(station): boolean
    + nextStation(station): Station
  }

  class Cargo {
    - identifier: String
    - description: String
    - weight: Decimal
    - status: CargoStatus
    + accept(): void
    + dispatch(train): void
    + collect(): void
  }
}

enum CargoStatus {
  AWAITING_ACCEPTANCE
  ACCEPTED_AT_STATION
  IN_TRANSIT
  COLLECTED
}

enum TrainStatus {
  READY
  IN_TRANSIT
  ARRIVED
}

User <|-- Administrator
User <|-- Operator

Station "1" o-- "0..*" Operator : employs
Train "1" *-- "1" Route : has
Route "1" o-- "2..*" Station : passes through

User "1" -- "0..*" Cargo : sender
Cargo "0..*" --> "1" Station : origin station
Cargo "0..*" --> "1" Station : destination station
Cargo "0..*" --> "0..1" Train : assigned to

Train --> TrainStatus
Cargo --> CargoStatus

Administrator ..> Station : manages
Administrator ..> Operator : manages
Administrator ..> Train : manages
Operator ..> Cargo : processes

@enduml
