@startuml
title Классы и роли системы «Железная дорога»

left to right direction
skinparam classAttributeIconSize 0
skinparam nodesep 80
skinparam ranksep 90
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam ClassBorderColor #2F5D8A
skinparam ClassBackgroundColor #FFFFFF
hide empty members

abstract class User {
  - identifier: String
  - passwordHash: String
  - name: String
}

class Administrator {
  + createUser(name): UserCredentials
  + manageInfrastructure(): void
}

class Operator {
  + listStationCargo(status): List<Cargo>
  + acceptCargo(cargoId): void
  + assignCargo(cargoId, train): void
  + registerTrainArrival(trainId): void
  + unloadCargo(cargoId): void
}

class Customer {
  + createShipment(cargo): Cargo
  + trackCargo(cargoId): CargoStatus
  + confirmPickup(cargoId): void
}

class Station {
  - code: String
  - name: String
}

class Train {
  - number: String
  - status: TrainStatus
  + serves(origin, destination): boolean
  + registerArrival(): void
}

class Cargo {
  - identifier: String
  - description: String
  - weight: Decimal
  - status: CargoStatus
  + accept(): void
  + dispatch(train): void
  + unload(): void
  + collect(): void
}

enum CargoStatus {
  AWAITING_ACCEPTANCE
  ACCEPTED_AT_STATION
  IN_TRANSIT
  AVAILABLE_FOR_PICKUP
  COLLECTED
}

enum TrainStatus {
  READY
  IN_TRANSIT
  ARRIVED
}

Administrator -up-|> User
Operator -up-|> User
Customer -up-|> User

Station "1" <-- "0..*" Operator : station
Train "0..*" --> "1" Station : origin
Train "0..*" --> "1" Station : destination
Cargo "0..*" --> "1" Station : origin
Cargo "0..*" --> "1" Station : destination
Cargo "0..*" --> "0..1" Train : assigned train
Cargo "0..*" --> "1" Customer : sender
Cargo "0..*" --> "1" Customer : recipient

Train ..> TrainStatus
Cargo ..> CargoStatus

@enduml
