@startuml
!pragma layout smetana
title Диаграмма вариантов использования системы «Железная дорога»

top to bottom direction
skinparam nodesep 32
skinparam ranksep 44
skinparam roundcorner 8
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam ArrowColor #344054
skinparam ActorBorderColor #172033
skinparam ActorFontColor #172033
skinparam UsecaseBorderColor #2F5D8A
skinparam UsecaseBackgroundColor #FFFFFF
skinparam RectangleBorderColor #455468
skinparam RectangleBackgroundColor #F7F9FC

actor "Участник системы" as systemActor
actor "Администратор" as admin
actor "Оператор\nна станции" as operator
actor "Пользователь /\nполучатель" as user

rectangle "Общий доступ\n\n" as common {
  usecase "Войти в систему" as login
  usecase "Выйти из системы" as logout
}

rectangle "Администрирование\n\n" as adminScope {
  usecase "Создать учётную\nзапись пользователя" as createUser
  usecase "Управлять станциями" as stations
  usecase "Управлять операторами" as operators
  usecase "Управлять поездами" as trains
}

rectangle "Работа оператора станции\n\n" as operatorScope {
  usecase "Просмотреть список\nгрузов станции" as listCargo
  usecase "Принять груз" as receive
  usecase "Распределить груз\nпо поездам" as distribute
  usecase "Зарегистрировать\nприбытие поезда" as arrival
  usecase "Выгрузить груз\nна станции" as unload
}

rectangle "Работа пользователя\n\n" as userScope {
  usecase "Отправить груз" as send
  usecase "Отследить груз" as track
  usecase "Просмотреть станции" as listStations
  usecase "Подтвердить получение\nгруза" as pickup
}


' Вход и выход — общие сценарии всех ролей.
admin -left-|> systemActor
operator -left-|> systemActor
user -left-|> systemActor
systemActor --> login
systemActor --> logout

' Каждый актёр связан только со своей группой вариантов использования.
admin --> createUser
admin --> stations
admin --> operators
admin --> trains

operator --> listCargo
operator --> receive
operator --> distribute
operator --> arrival
operator --> unload

user --> send
user --> track
user --> listStations
user --> pickup

' Сетка 2×2: общие сценарии и администрирование сверху,
' группы оператора и пользователя снизу.
common -[hidden]right-> adminScope
operatorScope -[hidden]right-> userScope
common -[hidden]down-> operatorScope
adminScope -[hidden]down-> userScope

@enduml
